// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USERS (NextAuth.js Compatible)
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?   // For credentials login
  image         String?
  role          UserRole  @default(VIEWER)
  department    String?
  phone         String?
  active        Boolean   @default(true)

  // NextAuth Relations
  accounts      Account[]
  sessions      Session[]

  // Project Management Relations
  projects      Project[]
  teamMembers   TeamMember[]
  activityLogs  ActivityLog[]
  comments      Comment[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PROJECT_MANAGER
  MARKETING
  FINANCE
  VIEWER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// CLIENT MANAGEMENT
// ============================================

model Client {
  id            String    @id @default(cuid())
  name          String
  email         String?
  phone         String?
  company       String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  country       String?   @default("USA")
  notes         String?   @db.Text
  status        ClientStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  projects      Project[]

  @@map("clients")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

// ============================================
// PROJECT MANAGEMENT
// ============================================

model Project {
  id                String          @id @default(cuid())
  title             String
  description       String?         @db.Text
  richDescription   String?         @db.Text // Rich text HTML content
  slug              String          @unique
  status            ProjectStatus   @default(DRAFT)
  category          ProjectCategory
  priority          Priority        @default(MEDIUM)

  // Client & Location
  clientId          String?
  client            Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  location          String?
  address           String?
  city              String?
  state             String?
  zipCode           String?
  latitude          Float?
  longitude         Float?

  // Dates
  startDate         DateTime?
  endDate           DateTime?
  actualStartDate   DateTime?
  actualEndDate     DateTime?

  // Budget
  estimatedBudget   Decimal?        @db.Decimal(12, 2)
  actualCost        Decimal?        @db.Decimal(12, 2)

  // Progress
  progressPercent   Int             @default(0)

  // Owner
  ownerId           String?
  owner             User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  // Metadata
  featured          Boolean         @default(false)
  publishedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  services          ProjectService[]
  images            ProjectImage[]
  documents         ProjectDocument[]
  milestones        Milestone[]
  phases            ProjectPhase[]
  team              TeamMember[]
  equipment         ProjectEquipment[]
  certifications    ProjectCertification[]
  activityLogs      ActivityLog[]
  comments          Comment[]
  tags              ProjectTag[]

  @@map("projects")
}

enum ProjectStatus {
  DRAFT
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum ProjectCategory {
  COMMUNICATIONS
  CONSTRUCTION
  BOTH
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ============================================
// PROJECT SERVICES
// ============================================

model Service {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  category    ProjectCategory
  icon        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projects    ProjectService[]

  @@map("services")
}

model ProjectService {
  id          String    @id @default(cuid())
  projectId   String
  serviceId   String
  notes       String?
  createdAt   DateTime  @default(now())

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([projectId, serviceId])
  @@map("project_services")
}

// ============================================
// IMAGES & DOCUMENTS
// ============================================

model ProjectImage {
  id          String    @id @default(cuid())
  projectId   String
  url         String
  thumbnailUrl String?
  caption     String?
  altText     String?
  width       Int?
  height      Int?
  fileSize    Int?
  mimeType    String?
  phase       String?   // Which phase this image belongs to
  order       Int       @default(0)
  isPrimary   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_images")
}

model ProjectDocument {
  id          String        @id @default(cuid())
  projectId   String
  name        String
  description String?
  url         String
  fileSize    Int?
  mimeType    String?
  category    DocumentCategory
  version     String        @default("1.0")
  uploadedAt  DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_documents")
}

enum DocumentCategory {
  CONTRACT
  PLAN
  SPECIFICATION
  CHANGE_ORDER
  INSPECTION_REPORT
  PHOTO
  FINAL_DELIVERABLE
  PERMIT
  CERTIFICATION
  OTHER
}

// ============================================
// PROJECT TIMELINE & MILESTONES
// ============================================

model ProjectPhase {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      PhaseStatus @default(PENDING)
  order       Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestones  Milestone[]

  @@map("project_phases")
}

enum PhaseStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  phaseId     String?
  title       String
  description String?   @db.Text
  dueDate     DateTime
  completedAt DateTime?
  status      MilestoneStatus @default(PENDING)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase       ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@map("milestones")
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

// ============================================
// TEAM & EQUIPMENT
// ============================================

model TeamMember {
  id          String    @id @default(cuid())
  projectId   String
  userId      String
  role        String
  startDate   DateTime  @default(now())
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("team_members")
}

model Equipment {
  id          String    @id @default(cuid())
  name        String
  description String?
  model       String?
  serialNumber String?
  category    String?
  isAvailable Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projects    ProjectEquipment[]

  @@map("equipment")
}

model ProjectEquipment {
  id          String    @id @default(cuid())
  projectId   String
  equipmentId String
  quantity    Int       @default(1)
  startDate   DateTime?
  endDate     DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([projectId, equipmentId])
  @@map("project_equipment")
}

// ============================================
// CERTIFICATIONS & COMPLIANCE
// ============================================

model Certification {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  issuingBody String?
  category    ProjectCategory?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projects    ProjectCertification[]

  @@map("certifications")
}

model ProjectCertification {
  id              String    @id @default(cuid())
  projectId       String
  certificationId String
  certNumber      String?
  issuedDate      DateTime?
  expiryDate      DateTime?
  documentUrl     String?
  notes           String?
  createdAt       DateTime  @default(now())

  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@unique([projectId, certificationId])
  @@map("project_certifications")
}

// ============================================
// ACTIVITY LOG & COMMENTS
// ============================================

model ActivityLog {
  id          String    @id @default(cuid())
  projectId   String
  userId      String?
  action      String
  description String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

model Comment {
  id          String    @id @default(cuid())
  projectId   String
  userId      String
  content     String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

// ============================================
// TAGS
// ============================================

model Tag {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  color       String?
  createdAt   DateTime  @default(now())

  projects    ProjectTag[]

  @@map("tags")
}

model ProjectTag {
  id          String    @id @default(cuid())
  projectId   String
  tagId       String
  createdAt   DateTime  @default(now())

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([projectId, tagId])
  @@map("project_tags")
}
