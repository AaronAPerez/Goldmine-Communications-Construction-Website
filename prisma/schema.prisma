generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(VIEWER)
  department    String?
  phone         String?
  active        Boolean   @default(true)
  
  accounts      Account[]
  sessions      Session[]
  projects      Project[] @relation("ProjectManager")
  clients       Client[]  @relation("ClientAssignee")
  notes         Note[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([email])
  @@index([role])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PROJECT_MANAGER
  MARKETING
  FINANCE
  FIELD_TECH
  VIEWER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// CLIENTS & CRM
// ============================================

model Client {
  id              String        @id @default(cuid())
  type            ClientType
  companyName     String?
  firstName       String
  lastName        String
  email           String        @unique
  phone           String
  alternatePhone  String?
  
  // Address as JSON
  address         Json          // { street, city, state, zip }
  
  // Lead management
  source          LeadSource
  status          ClientStatus
  assignedToId    String
  assignedTo      User          @relation("ClientAssignee", fields: [assignedToId], references: [id])

  // Relations
  projects        Project[]
  notes           Note[]
  
  // Metrics
  lifetimeValue   Decimal       @default(0) @db.Decimal(12, 2)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([email])
  @@index([status])
  @@index([assignedToId])
}

enum ClientType {
  RESIDENTIAL
  COMMERCIAL
  GOVERNMENT
  INDUSTRIAL
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  COLD_OUTREACH
  REPEAT_CLIENT
  OTHER
}

enum ClientStatus {
  LEAD
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  ACTIVE_CLIENT
  COMPLETED
  LOST
}

// ============================================
// PROJECTS
// ============================================

model Project {
  id              String          @id @default(cuid())
  title           String
  slug            String          @unique
  description     String          @db.Text
  category        ProjectCategory
  status          ProjectStatus   @default(DRAFT)
  priority        ProjectPriority @default(MEDIUM)
  
  // Client & team
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id])
  managerId       String
  manager         User            @relation("ProjectManager", fields: [managerId], references: [id])

  // Location as JSON
  location        Json            // { address, city, state, zip, lat, lng }

  // Timeline
  startDate       DateTime
  endDate         DateTime?
  estimatedEndDate DateTime?
  
  // Financial
  budgetAmount    Decimal?        @db.Decimal(12, 2)
  actualCost      Decimal?        @db.Decimal(12, 2)
  
  // Content
  images          ProjectImage[]
  notes           Note[]
  
  // Public website
  featured        Boolean         @default(false)
  publishedAt     DateTime?
  seoTitle        String?
  seoDescription  String?
  
  // Metadata
  tags            String[]
  services        String[]        // Array of service names
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@index([slug])
  @@index([clientId])
  @@index([managerId])
  @@index([status])
  @@index([category])
}

enum ProjectCategory {
  COMMUNICATIONS
  CONSTRUCTION
  BOTH
}

enum ProjectStatus {
  DRAFT
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model ProjectImage {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url         String   // Supabase storage URL
  caption     String?
  altText     String?
  order       Int      @default(0)
  featured    Boolean  @default(false)
  width       Int?
  height      Int?
  
  createdAt   DateTime @default(now())
  
  @@index([projectId])
  @@index([featured])
}

// ============================================
// NOTES & COMMUNICATION
// ============================================

model Note {
  id        String   @id @default(cuid())
  content   String   @db.Text
  
  // Relations (polymorphic-ish)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Author
  createdBy String
  user      User     @relation(fields: [createdBy], references: [id])
  
  pinned    Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([clientId])
  @@index([projectId])
  @@index([createdBy])
}