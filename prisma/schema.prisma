generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(VIEWER)
  department    String?
  phone         String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  clients       Client[]  @relation("ClientAssignee")
  notes         Note[]
  projects      Project[] @relation("ProjectManager")
  sessions      Session[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id             String       @id @default(cuid())
  type           ClientType
  companyName    String?
  firstName      String
  lastName       String
  email          String       @unique
  phone          String
  alternatePhone String?
  address        Json
  source         LeadSource
  status         ClientStatus
  assignedToId   String
  lifetimeValue  Decimal      @default(0) @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  assignedTo     User         @relation("ClientAssignee", fields: [assignedToId], references: [id])
  notes          Note[]
  projects       Project[]

  @@index([email])
  @@index([status])
  @@index([assignedToId])
}

model Project {
  id               String          @id @default(cuid())
  title            String
  slug             String          @unique
  description      String
  category         ProjectCategory
  status           ProjectStatus   @default(DRAFT)
  priority         ProjectPriority @default(MEDIUM)
  clientId         String
  managerId        String
  location         Json
  startDate        DateTime
  endDate          DateTime?
  estimatedEndDate DateTime?
  budgetAmount     Decimal?        @db.Decimal(12, 2)
  actualCost       Decimal?        @db.Decimal(12, 2)
  featured         Boolean         @default(false)
  publishedAt      DateTime?
  seoTitle         String?
  seoDescription   String?
  tags             String[]
  services         String[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  blueprintUrl     String?
  notes            Note[]
  client           Client          @relation(fields: [clientId], references: [id])
  manager          User            @relation("ProjectManager", fields: [managerId], references: [id])
  images           ProjectImage[]

  @@index([slug])
  @@index([clientId])
  @@index([managerId])
  @@index([status])
  @@index([category])
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  url       String
  caption   String?
  altText   String?
  order     Int      @default(0)
  featured  Boolean  @default(false)
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([featured])
}

model Note {
  id        String   @id @default(cuid())
  content   String
  clientId  String?
  projectId String?
  createdBy String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [createdBy], references: [id])
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([projectId])
  @@index([createdBy])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PROJECT_MANAGER
  MARKETING
  FINANCE
  FIELD_TECH
  VIEWER
}

enum ClientType {
  RESIDENTIAL
  COMMERCIAL
  GOVERNMENT
  INDUSTRIAL
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  COLD_OUTREACH
  REPEAT_CLIENT
  OTHER
}

enum ClientStatus {
  LEAD
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  ACTIVE_CLIENT
  COMPLETED
  LOST
}

enum ProjectCategory {
  COMMUNICATIONS
  CONSTRUCTION
  BOTH
}

enum ProjectStatus {
  DRAFT
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
